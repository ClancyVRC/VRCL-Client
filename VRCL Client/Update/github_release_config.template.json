{
  "schema_version": 2,
  "repository": {
    "owner": "ClancyVRC",
    "name": "VRCL-Client"
  },
  "default_channel": "beta",
  "channels": {
    "beta": {
      "asset_pattern": "VRCL_Client_{version}.zip",
      "prerelease": true
    },
    "stable": {
      "asset_pattern": "VRCL_Client_{version}.zip",
      "prerelease": false
    }
  },
  "latest_release_api": "https://api.github.com/repos/ClancyVRC/VRCL-Client/releases/latest",
  "release_list_api": "https://api.github.com/repos/ClancyVRC/VRCL-Client/releases?per_page=50",
  "release_tag_pattern": "v{version}",
  "updater_filename": "VRCL Updater.exe",
  "client_package_root": "VRCL_Client_{version}/VRCL Client",
  "protected_directory": "Data"
}